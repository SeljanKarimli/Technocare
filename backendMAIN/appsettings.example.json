{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDbSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "technocare",
    "UsersCollectionName": "users",
    "ProductsCollectionName": "products",
    "CartsCollectionName": "carts",
    "ShopCartsCollectionName": "shop_carts",
    "OrdersCollectionName": "orders",
    "NotificationsCollectionName": "notifications",
    "ServiceApplicationsCollectionName": "serviceapplications",
    "EducationApplicationsCollectionName": "educationapplications",
    "ProjectsCollectionName": "projects",
    "CategoriesCollectionName": "categories",
    "AddressesCollectionName": "addresses"
  },
  "JwtSettings": {
    "Secret": "replace-with-a-random-secret-at-least-32-characters-long",
    "ExpiryMinutes": 60,
    "Issuer": "Technocare",
    "Audience": "TechnocareClient"
  },
  "TechnocareSite": {
    "BaseUrl": "https://technocare.az",
    "SharedSecret": "use-the-same-random-secret-as-TECHNOCARE_APP_SHARED_SECRET",
    "CacheMinutes": 5,
    "TimeoutSeconds": 15
  },
  "Cors": {
    "AllowedOrigins": [
      "https://technocare.az",
      "https://www.technocare.az"
    ]
  },
  "AdminSettings": {
    "Email": "admin@example.com",
    "Password": "replace-with-a-strong-admin-password"
  },
  "EmailSettings": {
    "SmtpServer": "smtp.example.com",
    "SmtpPort": 587,
    "SmtpUser": "user@example.com",
    "SmtpPass": "replace-with-an-app-password",
    "SenderEmail": "noreply@example.com",
    "SenderName": "Technocare"
  }
}
